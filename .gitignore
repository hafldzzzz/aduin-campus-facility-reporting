# Konfigurasi dan rahasia lokal
/config/*
!/config/.htaccess
!/config/database.php
!/config/example.local.php
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
.ftpconfig
.ftppass
sftp-config.json
**/*credentials*
**/*secret*
**/*token*.json
**/local.php

# Data runtime; pertahankan struktur dan aturan akses Apache
/uploads/**
!/uploads/.htaccess
!/uploads/pengaduan/
!/uploads/pengaduan/.gitkeep
!/uploads/perbaikan/
!/uploads/perbaikan/.gitkeep
/storage/**
!/storage/.htaccess
!/storage/rate-limits/
!/storage/rate-limits/.gitkeep
*.log
sess_*
*.session

# Dump, backup, arsip, paket deployment, evidence runtime
*.sql
!/database/schema.sql
*.csv
*.pdf
*.zip
*.7z
*.rar
*.tar
*.gz
*.bak
*.backup
*.old
*.orig
*.save
/_deployment/
/_development/
/backups/
/logs/
/sessions/
/test-runtime*/
/evidence/

# Editor / sistem operasi / alat lokal
.idea/
.vscode/
.codex/
.agents/
.aws/
.DS_Store
Thumbs.db
desktop.ini
node_modules/
__pycache__/
*.pyc

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(?:config|includes|services|database|bin|tests|storage|backups|_deployment)(?:/|$) - [F,L,NC]
    RewriteRule \.(?:sql|log|bak|backup|old|orig|save|zip|tar|gz|ini|env|md|ps1|sh)$ - [F,L,NC]
</IfModule>
<FilesMatch "(?i)(^\.|\.(sql|log|bak|backup|old|orig|save|zip|tar|gz|ini|env|md|ps1|sh)$)">
    Require all denied
</FilesMatch>
